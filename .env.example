NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your-appwrite-project-id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=peerspark-main-db
NEXT_PUBLIC_APP_URL=https://studentssocial.vercel.app
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# Legacy aliases kept for older API routes/scripts. Keep these in sync with NEXT_PUBLIC_APPWRITE_DATABASE_ID.
NEXT_PUBLIC_DATABASE_ID=peerspark-main-db
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_DATABASE_ID=peerspark-main-db

# Appwrite collection IDs used by API routes. Defaults match scripts/update-schema.js.
NEXT_PUBLIC_PROFILES_COLLECTION_ID=profiles
NEXT_PUBLIC_POSTS_COLLECTION_ID=posts
NEXT_PUBLIC_COMMENTS_COLLECTION_ID=comments
NEXT_PUBLIC_MESSAGES_COLLECTION_ID=messages
NEXT_PUBLIC_RESOURCES_COLLECTION_ID=resources
NEXT_PUBLIC_NOTIFICATIONS_COLLECTION_ID=notifications
NEXT_PUBLIC_PODS_COLLECTION_ID=pods
NEXT_PUBLIC_CALENDAR_EVENTS_COLLECTION_ID=calendar_events
NEXT_PUBLIC_CHAT_ROOMS_COLLECTION_ID=chat_rooms
NEXT_PUBLIC_SAVED_POSTS_COLLECTION_ID=saved_posts
NEXT_PUBLIC_COURSES_COLLECTION_ID=courses
NEXT_PUBLIC_CHAPTERS_COLLECTION_ID=course_chapters
NEXT_PUBLIC_MESSAGE_RECEIPTS_COLLECTION_ID=message_receipts
NEXT_PUBLIC_CHAT_PRESENCE_COLLECTION_ID=chat_presence
NEXT_PUBLIC_AI_TASKS_COLLECTION_ID=ai_tasks
NEXT_PUBLIC_CALL_SESSIONS_COLLECTION_ID=call_sessions
NEXT_PUBLIC_CALL_PARTICIPANTS_COLLECTION_ID=call_participants
NEXT_PUBLIC_CALL_DIAGNOSTICS_COLLECTION_ID=call_diagnostics
NEXT_PUBLIC_NOTIFICATION_PREFERENCES_COLLECTION_ID=notification_preferences

# Appwrite storage bucket IDs used by uploads.
NEXT_PUBLIC_AVATARS_BUCKET_ID=avatars
NEXT_PUBLIC_RESOURCES_BUCKET_ID=resources
NEXT_PUBLIC_ATTACHMENTS_BUCKET_ID=attachments
NEXT_PUBLIC_POST_IMAGES_BUCKET_ID=post_images
NEXT_PUBLIC_POD_IMAGES_BUCKET_ID=pod_images

# Never commit real API keys. Put the real value only in .env.local or your deployment secret store.
APPWRITE_API_KEY=your-server-api-key
APPWRITE_SESSION_COOKIE_SECRET=replace-with-secure-random-key-min-32-chars

# LiveKit calling. Use wss:// for the public URL.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
CALL_E2EE_MASTER_KEY=replace-with-independent-random-key-min-32-chars

# Durable rate limiting (Upstash Redis REST API).
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ==================== ENTERPRISE SECURITY CONFIGURATION ====================

# JWT Token Signing Key
# Generate with: openssl rand -base64 32
# CRITICAL: Use a strong, random secret in production (minimum 32 characters)
JWT_SIGNING_KEY=replace-with-secure-random-key-min-32-chars

# Password Security
# Enable/disable password breach checking (integrates with haveibeenpwned.com)
PASSWORD_BREACH_CHECK_ENABLED=true

# Session Configuration
# Session duration in minutes
SESSION_DURATION_MINUTES=30
# Refresh token expiry in days
REFRESH_TOKEN_EXPIRY_DAYS=7
# Remember me duration in days (0 to disable)
REMEMBER_ME_DURATION_DAYS=30

# Rate Limiting Configuration
# Maximum registration attempts per IP per hour
RATE_LIMIT_REGISTER_MAX_ATTEMPTS=5
RATE_LIMIT_REGISTER_WINDOW_HOURS=1

# Maximum login attempts before account lockout
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
# Lockout duration in minutes
RATE_LIMIT_LOGIN_LOCKOUT_MINUTES=15

# Maximum password reset requests per email per day
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW_HOURS=24

# Maximum email verification requests per email per day
RATE_LIMIT_EMAIL_VERIFY_MAX=5
RATE_LIMIT_EMAIL_VERIFY_WINDOW_HOURS=24

# Account Lockout Configuration
# Maximum failed login attempts before lockout
ACCOUNT_LOCKOUT_MAX_FAILED_ATTEMPTS=5
# Initial lockout duration in minutes (increases with exponential backoff)
ACCOUNT_LOCKOUT_INITIAL_MINUTES=15
# Maximum lockout duration in minutes
ACCOUNT_LOCKOUT_MAX_MINUTES=60

# Email Configuration for Auth Events
# Email service for sending verification and reset links
EMAIL_SERVICE=sendgrid  # Options: sendgrid, mailgun, smtp
EMAIL_FROM_ADDRESS=noreply@studentssocial.app
EMAIL_FROM_NAME=Student Social

# SendGrid API Key (if using SendGrid)
SENDGRID_API_KEY=replace-with-sendgrid-api-key

# SMTP Configuration (if using SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Verification & Reset Token Configuration
# Email verification token expiry in minutes
EMAIL_VERIFICATION_TOKEN_EXPIRY_MINUTES=15
# Password reset token expiry in hours
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=1

# Security Headers
# CORS origins allowed for authentication
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://studentssocial.app

# Two-Factor Authentication (if implementing)
TWO_FACTOR_ENABLED=false
TWO_FACTOR_WINDOW_SECONDS=30

# Audit Logging
# Enable audit trail logging
AUDIT_LOGGING_ENABLED=true
# Send audit logs to external service (optional)
AUDIT_LOG_SERVICE=  # Options: datadog, sentry, cloudwatch
AUDIT_LOG_LEVEL=all  # Options: all, critical, warning

# Device Fingerprinting
# Enable device fingerprinting and tracking
DEVICE_FINGERPRINTING_ENABLED=true
# Require device verification for new devices
DEVICE_VERIFICATION_REQUIRED=false
# Send email notification on new device login
DEVICE_LOGIN_NOTIFICATION_ENABLED=true
RESEND_API_KEY=
SECURITY_EMAIL_FROM=Student.social Security <security@studentssocial.app>

# IP Blocking Configuration
# Block login attempts from suspicious IPs
IP_BLOCKING_ENABLED=false
# IP reputation service (if implementing)
IP_REPUTATION_SERVICE=  # Options: abuseipdb, google-safe-browsing

# Development/Debug
NEXT_PUBLIC_ENABLE_APPWRITE_DEBUG=false
# Enable detailed security logging in development
SECURITY_DEBUG_MODE=false

# ==================== NOTIFICATION SYSTEM CONFIGURATION ====================

# Notification Collection IDs
NOTIFICATION_PREFERENCES_COLLECTION_ID=notification_preferences
NOTIFICATION_TEMPLATES_COLLECTION_ID=notification_templates
NOTIFICATION_QUEUE_COLLECTION_ID=notification_queue
NOTIFICATION_DELIVERY_LOGS_COLLECTION_ID=notification_delivery_logs
IN_APP_NOTIFICATIONS_COLLECTION_ID=in_app_notifications
NOTIFICATION_DEVICE_TARGETS_COLLECTION_ID=notification_device_targets
USER_ACTIVITY_STATE_COLLECTION_ID=user_activity_state
NOTIFICATION_RATE_LIMITS_COLLECTION_ID=notification_rate_limits
NOTIFICATION_SUPPRESSION_COLLECTION_ID=notification_suppression
ADMIN_BROADCASTS_COLLECTION_ID=admin_broadcasts

# Appwrite Messaging Provider IDs
# Get these from your Appwrite Console after setting up providers
APPWRITE_EMAIL_PROVIDER_ID=brevo-smtp
APPWRITE_PUSH_PROVIDER_ID=fcm
APPWRITE_SMS_PROVIDER_ID=twilio  # Optional

# Notification Settings
NOTIFICATION_FROM_NAME=Peerspark
NOTIFICATION_FROM_EMAIL=notifications@peerspark.app
PEERSPARK_APP_URL=https://peerspark.app

# Feature Toggles
SMS_ENABLED=false
MARKETING_NOTIFICATIONS_ENABLED=false
ADMIN_BROADCASTS_ENABLED=true

# Notification Rate Limits
NOTIFICATION_MAX_PUSH_PER_HOUR=3
NOTIFICATION_MAX_PUSH_PER_DAY=8
NOTIFICATION_MAX_EMAIL_PER_DAY=2
NOTIFICATION_MAX_SMS_PER_DAY=1

# Quiet Hours (Default)
NOTIFICATION_DEFAULT_QUIET_HOURS_START=22:00
NOTIFICATION_DEFAULT_QUIET_HOURS_END=07:00
NOTIFICATION_DEFAULT_TIMEZONE=UTC

# Worker Configuration
NOTIFICATIONS_WORKER_SECRET=replace-with-secure-worker-secret
NOTIFICATIONS_ADMIN_SECRET=replace-with-secure-admin-secret
APPWRITE_FUNCTION_ID=notification-worker

# Firebase Cloud Messaging (for push notifications)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ==================== PWA CALL ALERTS ====================
# Generate a VAPID pair with: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=https://studentssocial.vercel.app

# ==================== TWO-FACTOR AUTHENTICATION (2FA) ====================

# Enable/disable TOTP-based 2FA
TWO_FACTOR_ENABLED=false
# Allow users to use backup codes
TWO_FACTOR_BACKUP_CODES_ENABLED=true
# Number of backup codes to generate
TWO_FACTOR_BACKUP_CODES_COUNT=10
# Require 2FA for all users (enforce mode)
TWO_FACTOR_ENFORCE=false
# Allow remember device for 30 days
TWO_FACTOR_REMEMBER_DEVICE_DAYS=30

# ==================== ADDITIONAL SECURITY FEATURES ====================

# Email verification requirement
EMAIL_VERIFICATION_REQUIRED=true
# Login attempt tracking
LOGIN_ATTEMPT_TRACKING=true
# Require password change on first login
REQUIRE_PASSWORD_CHANGE_FIRST_LOGIN=false
# Password expiration (days, 0 to disable)
PASSWORD_EXPIRATION_DAYS=90
# Concurrent session limit per user
MAX_CONCURRENT_SESSIONS=5
# Session idle timeout (minutes)
SESSION_IDLE_TIMEOUT_MINUTES=30
# Require HTTPS
REQUIRE_HTTPS=true
